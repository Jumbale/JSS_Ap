<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #FFFAFA;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.contollers.ViewResults">
   <top>
      <VBox prefHeight="76.0" prefWidth="784.0" style="-fx-background-color: white;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="19.0" prefWidth="764.0" spacing="2.0">
               <children>
                  <Label text="View Results">
                     <font>
                        <Font name="FreeSans Bold" size="21.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <Label style="-fx-font-family: freesans;" text="View and manage students' results" />
         </children>
      </VBox>
   </top>
   <center>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <TilePane style="-fx-background-color: white; -fx-border-radius: 10; -fx-border-color: c0c0c0;" VBox.vgrow="NEVER">
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
               <children>
                  <VBox prefHeight="73.0" prefWidth="169.0">
                     <children>
                        <Label style="-fx-font-family: freesans;" text="Academic Year" />
                        <ComboBox fx:id="academicYear" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: silver; -fx-border-radius: 10;" />
                     </children>
                  </VBox>
                  <VBox prefHeight="73.0" prefWidth="169.0">
                     <children>
                        <Label style="-fx-font-family: freesans;" text="Term" />
                        <ComboBox fx:id="Year" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: silver; -fx-border-radius: 10;" />
                     </children>
                  </VBox>
                  <VBox prefHeight="73.0" prefWidth="169.0">
                     <children>
                        <Label style="-fx-font-family: freesans;" text="Class" />
                        <ComboBox fx:id="classViewResults" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: silver; -fx-border-radius: 10;" />
                     </children>
                  </VBox>
                  <VBox prefHeight="73.0" prefWidth="169.0">
                     <children>
                        <Label style="-fx-font-family: freesans;" text="Exam" />
                        <ComboBox fx:id="Exams" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: silver; -fx-border-radius: 10;" />
                     </children>
                  </VBox>
                  <VBox prefHeight="73.0" prefWidth="169.0">
                     <children>
                        <Label style="-fx-font-family: freesans;" text="Subject" />
                        <ComboBox fx:id="subjects" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: silver; -fx-border-radius: 10;" />
                     </children>
                  </VBox>
                  <Button fx:id="viewMarks" mnemonicParsing="false" style="-fx-background-color: blue; -fx-text-fill: white; -fx-font-family: freesans; -fx-font-weight: bold;" text="View Marks" TilePane.alignment="CENTER_LEFT" />
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </TilePane>
            <TilePane alignment="CENTER_LEFT" hgap="10.0" prefHeight="100.0" style="-fx-border-radius: 10; -fx-border-color: c0c0c0; -fx-background-color: #fff;" VBox.vgrow="NEVER">
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" />
               </VBox.margin>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <VBox prefHeight="44.0" prefWidth="118.0" style="-fx-border-radius: 10; -fx-border-color: c0c0c0;" TilePane.alignment="CENTER_LEFT">
                     <children>
                        <Label style="-fx-font-family: freesans;" text="Total Students" />
                        <Label fx:id="totalStudents" style="-fx-font-family: freesans; -fx-font-weight: bold;" text="50">
                           <font>
                              <Font size="19.0" />
                           </font>
                        </Label>
                     </children>
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                  </VBox>
                  <VBox prefHeight="44.0" prefWidth="118.0" style="-fx-border-radius: 10; -fx-border-color: c0c0c0;">
                     <children>
                        <Label style="-fx-font-family: freesans;" text="Marks Entered" />
                        <Label fx:id="marksEntered" style="-fx-font-family: freesans; -fx-font-weight: bold;" text="50">
                           <font>
                              <Font size="19.0" />
                           </font>
                        </Label>
                     </children>
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                  </VBox>
                  <VBox prefHeight="44.0" prefWidth="118.0" style="-fx-border-radius: 10; -fx-border-color: c0c0c0;">
                     <children>
                        <Label style="-fx-font-family: freesans;" text="Average Score" />
                        <Label fx:id="AverageScore" style="-fx-font-family: freesans; -fx-font-weight: bold;" text="50">
                           <font>
                              <Font size="19.0" />
                           </font>
                        </Label>
                     </children>
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                  </VBox>
                  <VBox prefHeight="44.0" prefWidth="118.0" style="-fx-border-radius: 10; -fx-border-color: c0c0c0;">
                     <children>
                        <Label style="-fx-font-family: freesans;" text="Highest Score" />
                        <Label fx:id="highestSCore" style="-fx-font-family: freesans; -fx-font-weight: bold;" text="50">
                           <font>
                              <Font size="19.0" />
                           </font>
                        </Label>
                     </children>
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                  </VBox>
                  <VBox prefHeight="44.0" prefWidth="118.0" style="-fx-border-radius: 10; -fx-border-color: c0c0c0;">
                     <children>
                        <Label style="-fx-font-family: freesans;" text="Lowest Score" />
                        <Label fx:id="lowestScore" style="-fx-font-family: freesans; -fx-font-weight: bold;" text="50">
                           <font>
                              <Font size="19.0" />
                           </font>
                        </Label>
                     </children>
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                  </VBox>
               </children>
            </TilePane>
            <VBox style="-fx-background-color: white; -fx-border-color: c0c0c0; -fx-border-radius: 10;" VBox.vgrow="NEVER">
               <VBox.margin>
                  <Insets left="10.0" right="10.0" />
               </VBox.margin>
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="778.0" spacing="10.0" style="-fx-background-radius: 10 10 0 0;">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                     <children>
                        <Label fx:id="marksOutOf" style="-fx-font-family: freesans;" text="Total Students: 40" />
                        <Label fx:id="hundredTotalMarks" style="-fx-font-family: freesans;" text="Marks out of: 100" />
                     </children>
                  </HBox>
                  <TableView fx:id="studentMarks" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: transparent;">
                     <columns>
                        <TableColumn fx:id="AdmissionNumber" prefWidth="75.0" style="-fx-font-family: freesans;" text="Adm. No." />
                        <TableColumn fx:id="studentName" prefWidth="75.0" style="-fx-font-family: freesans;" text="Student Name" />
                        <TableColumn fx:id="Gender" prefWidth="75.0" style="-fx-font-family: freesans;" text="Gender" />
                        <TableColumn fx:id="Marks" prefWidth="75.0" style="-fx-font-family: freesans;" text="Marks" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <VBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" />
                     </VBox.margin>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
