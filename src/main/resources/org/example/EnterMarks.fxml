<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<BorderPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #FFFAFA;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.contollers.EnterMarks">
   <top>
      <VBox prefHeight="76.0" prefWidth="784.0" style="-fx-background-color: white;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="19.0" prefWidth="764.0" spacing="2.0">
               <children>
                  <Label text="Enter Marks">
                     <font>
                        <Font name="FreeSans Bold" size="21.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <Label style="-fx-font-family: freesans;" text="Add marks for students" />
         </children>
      </VBox>
   </top>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <TilePane style="-fx-background-color: white; -fx-border-radius: 10; -fx-border-color: c0c0c0;" VBox.vgrow="NEVER">
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
               <children>
                  <VBox prefHeight="73.0" prefWidth="169.0">
                     <children>
                        <TextFlow prefHeight="9.0" prefWidth="169.0">
                           <children>
                              <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Academic Year" />
                              <Text fill="RED" strokeType="OUTSIDE" strokeWidth="0.0" text="*" />
                           </children>
                        </TextFlow>
                        <ComboBox fx:id="academicYear" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: silver; -fx-border-radius: 10;" />
                     </children>
                  </VBox>
                  <VBox prefHeight="73.0" prefWidth="169.0">
                     <children>
                        <TextFlow prefHeight="9.0" prefWidth="169.0">
                           <children>
                              <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Term" />
                              <Text fill="RED" strokeType="OUTSIDE" strokeWidth="0.0" text="*" />
                           </children>
                        </TextFlow>
                        <ComboBox fx:id="term" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: silver; -fx-border-radius: 10;" />
                     </children>
                  </VBox>
                  <VBox prefHeight="73.0" prefWidth="169.0">
                     <children>
                        <TextFlow prefHeight="9.0" prefWidth="169.0">
                           <children>
                              <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Class" />
                              <Text fill="RED" strokeType="OUTSIDE" strokeWidth="0.0" text="*" />
                           </children>
                        </TextFlow>
                        <ComboBox fx:id="classMarks" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: silver; -fx-border-radius: 10;" />
                     </children>
                  </VBox>
                  <VBox prefHeight="73.0" prefWidth="169.0">
                     <children>
                        <TextFlow prefHeight="9.0" prefWidth="169.0">
                           <children>
                              <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Exam" />
                              <Text fill="RED" strokeType="OUTSIDE" strokeWidth="0.0" text="*" />
                           </children>
                        </TextFlow>
                        <ComboBox fx:id="exam" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: silver; -fx-border-radius: 10;" />
                     </children>
                  </VBox>
                  <VBox prefHeight="73.0" prefWidth="169.0">
                     <children>
                        <TextFlow prefHeight="9.0" prefWidth="169.0">
                           <children>
                              <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Subject" />
                              <Text fill="RED" strokeType="OUTSIDE" strokeWidth="0.0" text="*" />
                           </children>
                        </TextFlow>
                        <ComboBox fx:id="subject" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: silver; -fx-border-radius: 10;" />
                     </children>
                  </VBox>
                  <Button fx:id="addMarks" mnemonicParsing="false" onMouseClicked="#addMarks" style="-fx-background-color: blue; -fx-text-fill: white; -fx-font-family: freesans; -fx-font-weight: bold;" text="Add Marks" />
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </TilePane>
            <VBox prefHeight="368.0" prefWidth="800.0" style="-fx-background-color: white; -fx-border-color: c0c0c0; -fx-border-radius: 10;" VBox.vgrow="NEVER">
               <VBox.margin>
                  <Insets left="10.0" right="10.0" />
               </VBox.margin>
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="778.0" spacing="10.0" style="-fx-background-radius: 10 10 0 0;">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                     <children>
                        <Label style="-fx-font-family: freesans;" text="Total Students: 40" />
                        <Label style="-fx-font-family: freesans;" text="Marks out of: 100" />
                     </children>
                  </HBox>
                  <TableView fx:id="viewResultsTable" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: transparent;">
                    <columns>
                      <TableColumn fx:id="admissionNumber" prefWidth="75.0" style="-fx-background-color: transparent;" text="Adm. No." />
                      <TableColumn fx:id="studentName" prefWidth="75.0" style="-fx-background-color: transparent;" text="Student Name" />
                        <TableColumn fx:id="geneder" prefWidth="75.0" style="-fx-background-color: transparent;" text="Gender" />
                        <TableColumn fx:id="marks" prefWidth="75.0" style="-fx-background-color: transparent;" text="Marks" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <VBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" />
                     </VBox.margin>
                  </TableView>
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0" />
         </children>
      </VBox>
   </center>
</BorderPane>
