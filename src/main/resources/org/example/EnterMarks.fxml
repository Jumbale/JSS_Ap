<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #FFFAFA;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.contollers.MarksRecords">
   <top>
      <VBox prefHeight="76.0" prefWidth="784.0" style="-fx-background-color: white;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="19.0" prefWidth="764.0" spacing="2.0">
               <children>
                  <Label text="Enter Marks">
                     <font>
                        <Font name="FreeSans Bold" size="21.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <Label style="-fx-font-family: freesans;" text="Add marks for students" />
         </children>
      </VBox>
   </top>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <VBox prefHeight="507.0" prefWidth="780.0" style="-fx-background-color: white; -fx-border-color: c0c0c0; -fx-border-radius: 10;" VBox.vgrow="ALWAYS">
               <VBox.margin>
                  <Insets bottom="20.0" left="10.0" right="10.0" />
               </VBox.margin>
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="778.0" spacing="10.0" style="-fx-background-radius: 10 10 0 0;">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                     <children>
                        <Label fx:id="ClassNameLabel" style="-fx-font-family: freesans;" text="Class" />
                        <Label fx:id="TotalStudentsLabel" style="-fx-font-family: freesans;" text="Total Students: 40" />
                     </children>
                  </HBox>
                  <TableView fx:id="ClassLevelResultsTable" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="AdmissionNumber" prefWidth="75.0" style="-fx-background-color: transparent;" text="Adm. No." />
                      <TableColumn fx:id="StudentName" prefWidth="75.0" style="-fx-background-color: transparent;" text="Student Name" />
                        <TableColumn fx:id="Gender" prefWidth="75.0" style="-fx-background-color: transparent;" text="Gender" />
                        <TableColumn fx:id="Actions" prefWidth="75.0" text="Actions" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <VBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" />
                     </VBox.margin>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
