<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<BorderPane prefHeight="513.0" prefWidth="780.0" style="-fx-background-color: #FFFAFA;" stylesheets="@dashboard.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.contollers.MarksForm">
   <center>
      <VBox prefHeight="571.0" prefWidth="800.0" BorderPane.alignment="CENTER">
         <children>
            <TilePane style="-fx-background-color: white; -fx-border-radius: 10; -fx-border-color: c0c0c0;" VBox.vgrow="NEVER">
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
               <children>
                  <VBox prefHeight="73.0" prefWidth="169.0">
                     <children>
                        <TextFlow prefHeight="9.0" prefWidth="169.0">
                           <children>
                              <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Academic Year" />
                              <Text fill="RED" strokeType="OUTSIDE" strokeWidth="0.0" text="*" />
                           </children>
                        </TextFlow>
                        <ComboBox fx:id="academicYear" prefWidth="150.0" promptText="Academic year" style="-fx-background-color: white; -fx-border-color: silver; -fx-border-radius: 10;" />
                     </children>
                  </VBox>
                  <VBox prefHeight="73.0" prefWidth="169.0">
                     <children>
                        <TextFlow prefHeight="9.0" prefWidth="169.0">
                           <children>
                              <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Term" />
                              <Text fill="RED" strokeType="OUTSIDE" strokeWidth="0.0" text="*" />
                           </children>
                        </TextFlow>
                        <ComboBox fx:id="term" prefWidth="150.0" promptText="current term" style="-fx-background-color: white; -fx-border-color: silver; -fx-border-radius: 10;" />
                     </children>
                  </VBox>
                  <VBox prefHeight="73.0" prefWidth="169.0">
                     <children>
                        <TextFlow prefHeight="9.0" prefWidth="169.0">
                           <children>
                              <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Exam" />
                              <Text fill="RED" strokeType="OUTSIDE" strokeWidth="0.0" text="*" />
                           </children>
                        </TextFlow>
                        <ComboBox fx:id="exam" prefWidth="150.0" promptText="exam type" style="-fx-background-color: white; -fx-border-color: silver; -fx-border-radius: 10;" />
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </TilePane>
            <VBox prefHeight="368.0" prefWidth="800.0" style="-fx-background-color: white; -fx-border-color: c0c0c0; -fx-border-radius: 10;" VBox.vgrow="NEVER">
               <VBox.margin>
                  <Insets left="10.0" right="10.0" />
               </VBox.margin>
               <children>
                  <HBox prefHeight="320.0" prefWidth="778.0" spacing="10.0">
                     <children>
                        <VBox alignment="TOP_CENTER" prefHeight="295.0" prefWidth="151.0" spacing="22.0">
                           <HBox.margin>
                              <Insets bottom="10.0" left="10.0" top="10.0" />
                           </HBox.margin>
                           <children>
                              <Label style="-fx-font-family: FreeSans;" text="Admission Number" />
                              <Label layoutX="27.0" layoutY="10.0" style="-fx-font-family: FreeSans;" text="Subject Code" />
                              <Label layoutX="46.0" layoutY="28.0" style="-fx-font-family: FreeSans;" text="Student Score" />
                              <Label layoutX="66.0" layoutY="46.0" style="-fx-font-family: FreeSans;" text="School Name" />
                           </children>
                        </VBox>
                        <VBox alignment="TOP_CENTER" layoutX="20.0" layoutY="20.0" prefHeight="295.0" prefWidth="151.0" spacing="10.0">
                           <children>
                              <TextField fx:id="AdmNumber" styleClass="textField" stylesheets="@dashboard.css" />
                              <TextField fx:id="SubjectCode" layoutX="10.0" layoutY="10.0" styleClass="textField" stylesheets="@dashboard.css" />
                              <TextField fx:id="StudentScore" layoutX="10.0" layoutY="59.0" styleClass="textField" stylesheets="@dashboard.css" />
                              <TextField fx:id="SchoolName" layoutX="10.0" layoutY="108.0" styleClass="textField" stylesheets="@dashboard.css" />
                           </children>
                           <HBox.margin>
                              <Insets bottom="10.0" top="10.0" />
                           </HBox.margin>
                        </VBox>
                        <VBox alignment="TOP_CENTER" layoutX="181.0" layoutY="20.0" prefHeight="315.0" prefWidth="314.0" spacing="10.0">
                           <children>
                              <Label style="-fx-font-family: FreeSans;" text="Remarks/Comment:" />
                              <TextArea fx:id="Comment" prefHeight="126.0" prefWidth="274.0" promptText="remarks..." style="-fx-background-color: transparent; -fx-background-radius: 10px; -fx-border-color: #c0c0c0; -fx-border-radius: 10px;">
                                 <VBox.margin>
                                    <Insets left="40.0" />
                                 </VBox.margin>
                              </TextArea>
                              <Button fx:id="saveButton" mnemonicParsing="false" onMouseClicked="#save" prefHeight="27.0" prefWidth="68.0" styleClass="saveButton" stylesheets="@dashboard.css" text="Save">
                                 <VBox.margin>
                                    <Insets top="40.0" />
                                 </VBox.margin>
                              </Button>
                           </children>
                        </VBox>
                     </children>
                     <padding>
                        <Insets top="20.0" />
                     </padding>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
